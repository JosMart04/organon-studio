# ---------------------------------------------------------------------------
# Organon Studio — Backend (perfil local, Windows nativo)
# Copia este archivo a `server/.env` y rellena la contrasena real.
# `server/.env` esta en .gitignore y NUNCA debe versionarse.
# Spring lo carga con: spring.config.import=optional:file:./.env[.properties]
# ---------------------------------------------------------------------------

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/organon_local_db
SPRING_DATASOURCE_USERNAME=organon_admin
SPRING_DATASOURCE_PASSWORD=cambiame

SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Semilla de ejemplo (el debate Descartes-Spinoza-Hume-Kant). Apagada: el
# cuaderno se llena leyendo. Ponla a true una vez si quieres los datos de muestra.
ORGANON_SEED_ENABLED=false
